{{- if .Report -}}
  {{- with .Report -}}
    {{- if (or .Updated .Failed) -}}
      {{- $summary := printf "📦 <b>%d</b> Scanned | 📥 <b>%d</b> Updated | ❌ <b>%d</b> Failed" (len .Scanned) (len .Updated) (len .Failed) -}}
      {{- printf "\n%s\n\n" $summary -}}

      {{- if (or .Updated .Fresh .Failed .Skipped) -}}
<blockquote expandable>
        {{- range .Updated}}
          {{- printf "\n📥 Updated <b>%s</b> (%s)" .Name .ImageName -}}
        {{- end -}}

        {{/* Section: Errors/Skipped */}}
        {{- range .Failed}}
          {{- printf "\n⚠️ <b>%s</b>: %s" .Name .Error -}}
        {{- end -}}

        {{- range .Skipped}}
          {{- printf "\n⏩ Skipped <b>%s</b>: %s" .Name .Error -}}
        {{- end -}}
</blockquote>
      {{- end -}}

      {{/* Final Status Footer */}}
      {{"\n\n"}}Check <a href="https://dockerstatus.zorg.ch/">Status Dashboard</a>
    {{- end -}}
  {{- end -}}
{{- else -}}
  {{- range .Entries -}}{{.Message}}{{"\n"}}{{- end -}}
{{- end -}}
